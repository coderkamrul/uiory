# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# The publishable key is safe in the browser — Row Level Security in
# supabase/schema.sql decides who can read/write (public read, admin write).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional, server-only: only used by `npm run seed` to load the demo
# components. The app itself never needs it. NEVER expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
