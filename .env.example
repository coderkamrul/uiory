# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# The publishable key is safe in the browser — Row Level Security in
# supabase/schema.sql decides who can read/write (public read, admin write).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional, server-only: only used by `npm run seed` to load the demo
# components. The app itself never needs it. NEVER expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 media storage (zero-egress storage for component images/videos)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=component-media
R2_PUBLIC_URL=https://pub-your-bucket.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-bucket.r2.dev
